<?xml version="1.0"?>
<PCF
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../../../../../pcf.xsd">
  <CardViewPanel
    id="ABContactSummaryCV">
    <Require
      name="anABContact"
      type="ABContact"/>
    <Variable
      initialValue="new CustomAnalysis_Ext()"
      name="customAnalysis"
      type="CustomAnalysis_Ext"/>
    <Card
      id="Basics"
      title="DisplayKey.get(&quot;Web.ContactDetail.PageLinks.Basics&quot;)">
      <PanelRef
        def="ABContactSummaryDV(anABContact)">
        <Toolbar>
          <ToolbarButton
            action="trainingapp.base.AssignedUserUtil.selectLeastBusyUser(anABContact)"
            available="CurrentLocation.InEditMode"
            id="SuggestLeastBusyUserButton"
            label="DisplayKey.get(&quot;Training.SuggestLeastBusyUser&quot;)"/>
        </Toolbar>
      </PanelRef>
      <PanelRef>
        <Toolbar>
          <IteratorButtons
            iterator="ManishSharmaLV"/>
          <EditButtons/>
        </Toolbar>
        <ListViewPanel
          id="ManishSharmaLV">
          <Variable
            initialValue="new CustomAnalysis_Ext()"
            name="custom1"
            type="CustomAnalysis_Ext"/>
          <RowIterator
            editable="true"
            elementName="ElementManish"
            toAdd="custom1.addToArrayToPolicy(ElementManish)"
            toRemove="custom1.removeFromArrayToPolicy(ElementManish)"
            value="custom1.ArrayToPolicy"
            valueType="entity.PolicyDetail_Ext[]">
            <Row>
              <TextCell
                editable="true"
                id="id121"
                label="&quot;Policy Number&quot;"
                value="ElementManish.PolicyNumber"
                valueType="java.lang.Integer"/>
              <CurrencyCell
                editable="true"
                id="id432"
                label="&quot;Premium&quot;"
                value="ElementManish.Premium"/>
              <TextCell
                editable="true"
                id="id0990"
                label="&quot;Location1&quot;"
                value="ElementManish.Location1"/>
            </Row>
          </RowIterator>
        </ListViewPanel>
      </PanelRef>
    </Card>
    <Card
      id="SocialMedia"
      title="DisplayKey.get(&quot;Training.SocialMedia&quot;)">
      <DetailViewPanel>
        <InputColumn>
          <Label
            label="DisplayKey.get(&quot;Training.InstructorComplete&quot;)"/>
        </InputColumn>
      </DetailViewPanel>
    </Card>
    <Card
      id="AnalysisCard"
      title="DisplayKey.get(&quot;Training.Analysis&quot;)">
      <DetailViewPanel>
        <InputColumn>
          <TextInput
            editable="true"
            id="id1"
            label="&quot;Contact Tier&quot;"
            value="customAnalysis.ContactTier"/>
          <TextInput
            editable="true"
            id="id2"
            label="&quot;Customer Rating&quot;"
            value="customAnalysis.CustomRating"
            valueType="java.math.BigDecimal"/>
          <BooleanRadioInput
            editable="true"
            id="id3"
            label="&quot;Strategic Partner&quot;"
            value="customAnalysis.StrategicPartner">
            <PostOnChange/>
          </BooleanRadioInput>
          <TypeKeyInput
            editable="true"
            id="id21"
            label="&quot;Customer Invoicing&quot;"
            required="true"
            value="customAnalysis.DownPayment"
            valueType="typekey.InvoicingManish"/>
          <RangeInput
            editable="true"
            id="id1432"
            label="&quot;Premium&quot;"
            value="customAnalysis.DownPayment"
            valueRange="InvoicingManish.TF_STRATEGICFILTER.TypeKeys"
            valueType="typekey.InvoicingManish"
            visible="customAnalysis.StrategicPartner == true"/>
          <RangeInput
            editable="true"
            id="id76"
            label="&quot;Non Premium&quot;"
            value="customAnalysis.DownPayment"
            valueRange="InvoicingManish.TF_NONSTRATEGICFILTER.TypeKeys"
            valueType="typekey.InvoicingManish"
            visible="customAnalysis.StrategicPartner == false"/>
        </InputColumn>
        <InputColumn>
          <Label
            id="id989"
            label="&quot;Address&quot;"/>
          <TextInput
            editable="true"
            id="id32"
            label="&quot;Address Line1&quot;"
            value="customAnalysis.FKeyToContact.AddressLine1"
            visible="false"/>
          <TextInput
            editable="true"
            id="id322211"
            label="&quot;Address Line2&quot;"
            value="customAnalysis.FKeyToContact.AddressLine2"/>
          <TextInput
            editable="true"
            id="id878"
            label="&quot;Address Line3&quot;"
            value="customAnalysis.FKeyToContact.AddressLine3"/>
          <TextInput
            editable="true"
            id="id98912"
            label="&quot;City&quot;"
            value="customAnalysis.FKeyToContact.city"/>
          <TextInput
            editable="true"
            id="id87890"
            label="&quot;ZipCode&quot;"
            value="customAnalysis.FKeyToContact.Zipcode"/>
        </InputColumn>
      </DetailViewPanel>
    </Card>
    <Card
      id="card1"
      title="&quot;Configure Toadd nd ToRemove Property&quot;">
      <PanelRef>
        <Toolbar>
          <IteratorButtons
            iterator="manishLV"/>
          <EditButtons/>
        </Toolbar>
        <ListViewPanel
          id="manishLV">
          <RowIterator
            editable="true"
            elementName="policyIterator"
            toAdd="customAnalysis.addToArrayForPolicies(policyIterator)"
            toRemove="customAnalysis.removeFromArrayForPolicies(policyIterator)"
            value="customAnalysis.ArrayForPolicies"
            valueType="entity.MultiplePolicies_Ext[]">
            <Row>
              <TextCell
                editable="true"
                id="id090"
                label="&quot;Entity User Field&quot;"
                value="policyIterator.EntityUserFriendly"/>
              <TextCell
                editable="true"
                id="id121"
                label="&quot;Policy Number&quot;"
                value="policyIterator.PolicyNumber"/>
              <CurrencyCell
                editable="true"
                id="id123"
                label="&quot;Premium&quot;"
                value="policyIterator.premium"/>
              <TextCell
                editable="true"
                id="id0912"
                label="&quot;Location&quot;"
                value="policyIterator.Location"/>
            </Row>
          </RowIterator>
        </ListViewPanel>
      </PanelRef>
    </Card>
  </CardViewPanel>
</PCF>